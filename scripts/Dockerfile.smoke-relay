# Test tooling only: this binary is never included in the application image.
FROM rust:1.99.1-bookworm@sha256:e12566d5abc17a0da741628782cdb504b68b8961f5bfcf677936bf3e8b32de29 AS build
COPY container-relay.rs /relay.rs
RUN rustc -O /relay.rs -o /relay
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
COPY --from=build /relay /relay
USER 10001:10001
ENTRYPOINT ["/relay"]
