# Test tooling only: this binary is never included in the application image.
FROM rust:1.99.1-bookworm@sha256:48b7f435b8fc6378ce43b44f15e3a47fd8919b2825f835c39bd4bd3da50af5b8 AS build
COPY container-relay.rs /relay.rs
RUN rustc -O /relay.rs -o /relay
FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
COPY --from=build /relay /relay
USER 10001:10001
ENTRYPOINT ["/relay"]
