# Test tooling only: this binary is never included in the application image.
FROM rust:1.99.1-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS build
COPY container-relay.rs /relay.rs
RUN rustc -O /relay.rs -o /relay
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
COPY --from=build /relay /relay
USER 10001:10001
ENTRYPOINT ["/relay"]
