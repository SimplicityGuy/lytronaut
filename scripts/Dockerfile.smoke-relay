# Test tooling only: this binary is never included in the application image.
FROM rust:1.99.0-bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6 AS build
COPY container-relay.rs /relay.rs
RUN rustc -O /relay.rs -o /relay
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
COPY --from=build /relay /relay
USER 10001:10001
ENTRYPOINT ["/relay"]
